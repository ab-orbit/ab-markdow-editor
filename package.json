{
  "name": "ab-markdown-editor",
  "version": "1.16.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/build-pwa.mjs && node scripts/build-picker.mjs",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "stop": "node scripts/stop.mjs",
    "icons": "node scripts/build-icons.mjs",
    "ios:sync": "tsc --noEmit && VITE_STORAGE_MODE=browser VITE_APP_PLATFORM=ios vite build --outDir dist-ios && node scripts/prepare-ios.mjs && cap sync ios",
    "ios:open": "cap open ios",
    "ios:archive": "node scripts/archive-ios.mjs",
    "screenshots:store": "node scripts/build-store-screenshots.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@excalidraw/excalidraw": "0.18.1",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "@shikijs/langs": "4.5.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-task-item": "3.32.0",
    "@tiptap/extension-task-list": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@zenuml/core": "4.7.2",
    "beautiful-mermaid": "1.1.3",
    "dompurify": "3.4.17",
    "fflate": "^0.8.3",
    "lucide-react": "^1.7.0",
    "mermaid": "12.2.0",
    "pdfmake": "0.3.12",
    "pele": "1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "shiki": "4.5.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "^1.62.0",
    "@types/node": "^22",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.18"
    }
  }
}
